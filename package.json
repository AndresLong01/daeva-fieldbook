{
  "name": "daeva-fieldbook",
  "version": "1.0.5",
  "description": "An independent AION 2 gathering, timer, and notes companion",
  "author": "Daeva Fieldbook",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "build:capture": "dotnet publish capture-src/goal-capture.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o capture"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.daeva.fieldbook",
    "productName": "Daeva Fieldbook",
    "directories": {
      "output": "../../outputs/Daeva-Fieldbook-1.0.5"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "ui/**/*",
      {
        "from": "capture",
        "to": "capture",
        "filter": [
          "goal-capture.exe",
          "game-focus.ps1",
          "item-variants.json",
          "opcodes.json",
          "THIRD-PARTY-LICENSE.txt"
        ]
      },
      "package.json"
    ],
    "asarUnpack": [
      "capture/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Daeva-Fieldbook-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AndresLong01",
        "repo": "daeva-fieldbook",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndresLong01/daeva-fieldbook.git"
  }
}
